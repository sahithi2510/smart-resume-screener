# DATABASE_URL — two variants depending on where the app process runs:
#   Host machine (uvicorn/pytest run directly):  postgresql://postgres:postgres@localhost:5433/smart_resume_screener
#   Inside Docker (app container on same network): postgresql://postgres:postgres@db:5432/smart_resume_screener
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/smart_resume_screener

# Google AI API key — get yours free at https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Model used for structured extraction via response_schema.
# gemini-3.5-flash = fast, cost-efficient, strong at structured output (GA mid-2026)
# Override to gemini-3.5-pro for highest accuracy at higher cost.
LLM_MODEL=gemini-3.5-flash
